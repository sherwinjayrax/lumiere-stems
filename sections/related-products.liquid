{% comment %}
  Related / You may also like section — placed on product page
  Shows random products from the same collection, excluding current product
{% endcomment %}

{%- liquid
  assign current_product = product
  assign related_limit = 4
  assign related_collection = current_product.collections.first

  comment
    Build a pool of products excluding the current one
  endcomment
-%}

<section class="bg-white border-t border-black-primary">
  {%- comment -%} ── Heading ── {%- endcomment -%}
  <div class="text-center px-6 py-10 md:py-14 border-b border-black-primary">
    <h2 class="text-2xl md:text-3xl lg:text-4xl poppins-medium text-black-primary">
      {{ section.settings.heading | default: 'You may also like...' }}
    </h2>
  </div>

  {%- comment -%} ── Product Grid ── {%- endcomment -%}
  {%- if related_collection != blank -%}
    {%- assign pool = related_collection.products -%}
  {%- else -%}
    {%- assign pool = collections.all.products -%}
  {%- endif -%}

  {%- comment -%} Collect eligible products (exclude current) {%- endcomment -%}
  {%- assign eligible_count = 0 -%}

  {%- for p in pool -%}
    {%- if p.id != current_product.id -%}
      {%- assign eligible_count = eligible_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="product-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
    {%- assign displayed = 0 -%}

    {%- comment -%}
      Shopify doesn't have a native random sort in Liquid for collection products,
      so we use offset based on the current second to simulate randomness.
      This changes on every page load.
    {%- endcomment -%}
    {%- assign offset = 'now' | date: '%S' | modulo: eligible_count | default: 0 -%}
    {%- assign loop_count = 0 -%}

    {%- for p in pool -%}
      {%- if displayed >= related_limit -%}
        {%- break -%}
      {%- endif -%}

      {%- if p.id == current_product.id -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign loop_count = loop_count | plus: 1 -%}

      {%- if loop_count <= offset -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign displayed = displayed | plus: 1 -%}

      <a
        href="{{ p.url}}"
        class="product-card group flex flex-col text-center bg-white hover:bg-gray-50 transition-colors duration-200 border-b border-r border-black-primary"
      >
        {%- comment -%} Image {%- endcomment -%}
        <div class="flex items-center justify-center overflow-hidden border-b border-black-primary">
          {%- if p.featured_image != blank -%}
            {{
              p.featured_image
              | image_url: width: 600
              | image_tag:
                alt: p.featured_image.alt,
                loading: 'lazy',
                class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300'
            }}
          {%- else -%}
            <div class="w-full h-full bg-gray-100 flex items-center justify-center">
              <span class="text-gray-400 text-xs">No image</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Info {%- endcomment -%}
        <div class="flex flex-col py-8 lg:py-4">
          <p class="text-base poppins-medium text-black-primary mb-1 leading-snug">
            {{ p.title }}
          </p>
          <p class="text-sm poppins-medium text-[#808080]">{{ p.price | money }}</p>
        </div>
      </a>
    {%- endfor -%}
    {%- if displayed < related_limit -%}
      {%- for p in pool -%}
        {%- if displayed >= related_limit -%}{%- break -%}{%- endif -%}
        {%- if p.id == current_product.id -%}{%- continue -%}{%- endif -%}

        {%- assign displayed = displayed | plus: 1 -%}

        <a
          href="{{ p.url }}"
          class="product-card group flex flex-col text-center bg-white hover:bg-gray-50 transition-colors duration-200 border-b border-r border-black-primary"
        >
          <div class="flex items-center justify-center overflow-hidden border-b border-black-primary">
            {%- if p.featured_image != blank -%}
              {{
                p.featured_image
                | image_url: width: 600
                | image_tag:
                  alt: p.featured_image.alt,
                  loading: 'lazy',
                  class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300'
              }}
            {%- else -%}
              <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                <span class="text-gray-400 text-xs">No image</span>
              </div>
            {%- endif -%}
          </div>

          <div class="flex flex-col py-8 lg:py-4">
            <p class="text-base poppins-medium text-black-primary mb-1 leading-snug">
              {{ p.title }}
            </p>
            <p class="text-sm poppins-medium text-[#808080]">{{ p.price | money }}</p>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% style %}
  /* ========== BASE (Mobile: 1 column) ========== */
  .product-grid .product-card {
    border-right: none; /* no vertical borders in 1 col */
  }

  /* remove bottom border for last item */
  .product-grid .product-card:last-child {
    border-bottom: none;
  }

  /* ========== Tablet (≥768px → 2 columns) ========== */
  @media (min-width: 768px) {
    /* restore right borders */
    .product-grid .product-card {
      border-right: 1px solid;
    }

    /* remove right border on every 2nd item (last column) */
    .product-grid .product-card:nth-child(2n) {
      border-right: none;
    }

    /* remove bottom borders for last row (max 2 items) */
    .product-grid .product-card:nth-last-child(-n + 2) {
      border-bottom: none;
    }

    /* FIX: if odd number (e.g., 3 items), last item should KEEP right border */
    .product-grid .product-card:last-child:nth-child(odd) {
      border-right: 1px solid;
    }
  }

  /* ========== Desktop (≥1024px → 4 columns) ========== */
  @media (min-width: 1024px) {
    /* remove right border on every 4th item */
    .product-grid .product-card:nth-child(4n) {
      border-right: none;
    }

    /* remove bottom borders for last row (max 4 items) */
    .product-grid .product-card:nth-last-child(-n + 4) {
      border-bottom: none;
    }

    /* FIX: incomplete last row (1–3 items) should still show separators */
    .product-grid .product-card:nth-last-child(-n + 3) {
      border-right: 1px solid;
    }

    /* but true last item should not have right border */
    .product-grid .product-card:last-child {
      border-right: none;
    }
  }
{% endstyle %}
{% schema %}
{
  "name": "You May Also Like",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ],
  "presets": [
    {
      "name": "You May Also Like"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
